# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL connection URL format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite development: sqlite:///./app.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_enrollment

# ==============================================================================
# JWT & Authentication
# ==============================================================================
# Secure random key for signing tokens (e.g. generate via: openssl rand -hex 32)
SECRET_KEY=your_generated_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
AI_API_KEY=your_ai_api_key_here
AI_MODEL=openai/gpt-oss-120b